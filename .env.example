# ---------------------------------------------------------------------------
# Sanity — painel de conteúdo (https://sanity.io/manage)
# Enquanto estas variáveis estiverem vazias o site roda com conteúdo de exemplo
# (fixtures locais). Preencha-as para ligar o site ao CMS de verdade.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token "Viewer" (sanity.io/manage → API → Tokens). Só no servidor. Liga o
# "Ver no site" do painel, que mostra rascunhos antes de publicar.
SANITY_API_READ_TOKEN=

# Token de escrita (sanity.io/manage → API → Tokens com permissão Editor).
# Usado apenas para rodar o script `npm run seed` para importar conteúdo para o Sanity.
SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Endereço público do site, base do sitemap e das imagens de compartilhamento.
# Na Vercel é detectado sozinho; preencha se usar domínio próprio.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://labho.vercel.app
